{
  "listen": "127.0.0.1:8787",
  "upstream": "https://api.cline.bot/api/v1",
  "api_key": "",
  "forward_headers": ["x-client-type"],
  "probe_headers": {
    "x-client-type": "cline-cli"
  },
  "max_body_bytes": 67108864,

  "watch_seconds": 5,
  "admin_token": "",
  "admin_allow_unauthenticated": false,

  "unwrap_data_envelope": true,

  "rules": [
    {
      "name": "deepseek",
      "model": "deepseek",
      "match": "contains",
      "pipeline": "auto",
      "mode": "strict",
      "upstreams": ["deepseek"]
    },
    {
      "name": "glm-5.3-flash",
      "model": "glm-5.3-flash",
      "match": "contains",
      "pipeline": "auto",
      "mode": "strict",
      "upstreams": ["relace"]
    },
    {
      "name": "glm-5.3",
      "model": "glm-5.3",
      "match": "contains",
      "pipeline": "auto",
      "mode": "strict",
      "upstreams": ["friendli"]
    }
  ]
}
