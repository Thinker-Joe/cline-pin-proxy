# Keep text files on LF across Windows and Linux checkouts.
* text=auto eol=lf

*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
.gitignore    text eol=lf
LICENSE       text eol=lf

*.exe   binary
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
